# 复制成 .env 即生效：docker compose 自动读取它，应用也从环境变量读全部配置。
#
#     cp .env.example .env
#
# 这里有两类变量，别混淆：
#
#   TA_*     应用自己的配置。前缀固定 TA_，键名是配置路径把点换成下划线
#            （amqp.scheduled_job_due.consumers -> TA_AMQP_SCHEDULED_JOB_DUE_CONSUMERS）
#   其余     只给 docker-compose.yml 用，配依赖容器与端口映射
#
# 没有 config.yaml。全部配置 = 内置默认值 + 这里的环境变量，只有一个来源。

# ===========================================================================
# 编排（只给 docker-compose.yml 用）
# ===========================================================================
MYSQL_PASSWORD=trading_agents
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
API_PORT=8080
RABBITMQ_UI_PORT=15672

# ===========================================================================
# 应用：基础
# ===========================================================================
TA_APP_NAME=trading-agents
# dev / test / prod。prod 会强制校验 jwt_secret 不是默认值。
TA_APP_ENV=dev

TA_HTTP_HOST=0.0.0.0
TA_HTTP_PORT=8080
TA_HTTP_READ_TIMEOUT=30s
# 写超时必须大于一次完整分析的耗时上限，否则 SSE 进度长连接会被服务端掐断
TA_HTTP_WRITE_TIMEOUT=10m

TA_LOG_LEVEL=info
TA_LOG_FORMAT=json

# ===========================================================================
# 应用：数据存储
# ===========================================================================
TA_MYSQL_HOST=mysql
TA_MYSQL_PORT=3306
TA_MYSQL_USER=root
TA_MYSQL_PASSWORD=trading_agents
TA_MYSQL_DATABASE=trading_agents
TA_MYSQL_MAX_OPEN_CONNS=50
TA_MYSQL_MAX_IDLE_CONNS=10
TA_MYSQL_CONN_MAX_LIFETIME=1h

TA_MONGO_URI=mongodb://mongo:27017
TA_MONGO_DATABASE=trading_agents
TA_MONGO_TIMEOUT=10s
TA_MONGO_ENABLED=true

TA_REDIS_ADDR=redis:6379
TA_REDIS_PASSWORD=
TA_REDIS_DB=0
TA_REDIS_POOL_SIZE=20

# ===========================================================================
# 应用：消息队列
# ===========================================================================
#
# 这里只有连接信息与可调参数。交换机、队列名、路由键**不在配置里**——
# 它们定义在 internal/helpers/constants/mq.go，是代码的一部分。
#
# 为什么：队列名同时还是处理器订阅时用的常量。改配置不改常量，得到的是一个
# 「消费者活着但永远收不到消息」的服务——不报错，只是那条链路静默不工作。
# 既然改一个必须同时改另一个，它就不该有两份来源。
#
# 拓扑长这样（服务启动时自动声明）：
#
#   exchange.trading_agents  (direct)
#     +- queue.trading_agents_event   + .retry + .dlq    领域事件
#     +- queue.scheduled_job_due      + .retry + .dlq    定时任务到期
#
TA_AMQP_HOST=rabbitmq
TA_AMQP_PORT=5672
TA_AMQP_VHOST=/
TA_AMQP_USER=guest
TA_AMQP_PASSWORD=guest

# 队列没有单独配置时的默认重试策略
TA_AMQP_MAX_RETRIES=3
TA_AMQP_RETRY_DELAY=30s
TA_AMQP_RECONNECT_DELAY=5s
TA_AMQP_PUBLISH_TIMEOUT=10s

# 领域事件队列。处理器都是轻量写库，多开几个消费者没有下游压力上的顾虑。
TA_AMQP_DOMAIN_EVENT_CONSUMERS=4
TA_AMQP_DOMAIN_EVENT_PREFETCH=4
TA_AMQP_DOMAIN_EVENT_MAX_RETRIES=3
TA_AMQP_DOMAIN_EVENT_RETRY_DELAY=30s

# 定时任务队列。并发度按下游承受能力定，不按核数定：一次触发可能是一轮全市场同步。
# 预取固定为 1——预取多条只会让它们在一个消费者本地排队，旁边的副本闲着。
TA_AMQP_SCHEDULED_JOB_DUE_CONSUMERS=4
TA_AMQP_SCHEDULED_JOB_DUE_PREFETCH=1
TA_AMQP_SCHEDULED_JOB_DUE_MAX_RETRIES=3
# 比领域事件长得多：定时任务失败通常是上游整体不可用（限流、配额耗尽），
# 30 秒后重来大概率还是同样的结果。
#
# 注意：改这个值要先删旧的重试队列，否则服务会因为队列参数不一致直接启动失败：
#     docker compose exec rabbitmq rabbitmqctl delete_queue queue.scheduled_job_due.retry
TA_AMQP_SCHEDULED_JOB_DUE_RETRY_DELAY=2m

# ===========================================================================
# 应用：认证
# ===========================================================================
# 生产必须改。app.env=prod 时用默认值会被 validate 直接拒绝启动。
TA_AUTH_JWT_SECRET=change-me
TA_AUTH_ACCESS_TOKEN_TTL=2h
TA_AUTH_REFRESH_TOKEN_TTL=720h
TA_AUTH_BCRYPT_COST=12
# 用户表为空时自动创建的初始管理员
TA_AUTH_BOOTSTRAP_ADMIN=admin
TA_AUTH_BOOTSTRAP_ADMIN_PASSWORD=admin12345

# ===========================================================================
# 应用：分析任务队列（Redis）
# ===========================================================================
TA_QUEUE_MAX_ATTEMPTS=3
TA_QUEUE_USER_CONCURRENCY=3
TA_QUEUE_GLOBAL_CONCURRENCY=20
TA_QUEUE_SLOT_TTL=6h
TA_QUEUE_PROGRESS_TTL=2h

# ===========================================================================
# 应用：大模型
# ===========================================================================
TA_LLM_DEFAULT_MODEL=deepseek-chat
TA_LLM_TIMEOUT=180s
TA_LLM_MAX_PARALLEL=4

# 供应商列表是个数组，环境变量放不下结构，所以用一个 JSON 串表达。
# 留空也行：供应商的运行期来源是配置中心（数据库），这里只是冷启动兜底。
# 写坏了会让启动直接失败，不会静默忽略。
#
# TA_LLM_PROVIDERS_JSON=[{"name":"deepseek","kind":"openai_compat","baseUrl":"https://api.deepseek.com/v1","apiKey":"sk-xxx","models":["deepseek-chat"],"enabled":true}]
TA_LLM_PROVIDERS_JSON=

# ===========================================================================
# 应用：行情数据源
# ===========================================================================
TA_MARKET_TUSHARE_TOKEN=
TA_MARKET_FINNHUB_TOKEN=
TA_MARKET_TIMEOUT=30s
# 无任何真实数据源时启用确定性 mock，使系统可在零密钥下端到端跑通（仅供联调）
TA_MARKET_ENABLE_MOCK=true
# 全量同步的并发上限。由数据源配额决定，不由核数决定：
# Tushare 免费档约 500 次/分钟，Finnhub 免费档 60 次/分钟。
TA_MARKET_SYNC_FAN_OUT_LIMIT=8
TA_MARKET_SYNC_CHUNK_SIZE=200

TA_MARKET_PROVIDERS=

TA_AUTH_BOOTSTRAP_ADMIN_PASSWORD=admin12345