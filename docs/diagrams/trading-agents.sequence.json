{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "分析任务端到端路径追踪",
    "locale": "zh-CN",
    "output": "trading-agents.sequence.html",
    "viewBox": [
      1700,
      712
    ],
    "column_fit": "spread",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "sync-accept",
        "label": "同步受理",
        "focus": [
          "client",
          "api",
          "redis",
          "mysql",
          "mq"
        ],
        "note": "槽位先于落库获取，任一步失败都回滚槽位，HTTP 在派发后立刻返回。"
      },
      {
        "id": "async-run",
        "label": "异步执行",
        "focus": [
          "mq",
          "worker",
          "engine",
          "llm",
          "mongo"
        ],
        "note": "Worker 原子认领任务，Engine 带 25 分钟 deadline 驱动 14 个 agent。"
      },
      {
        "id": "observe",
        "label": "进度观测",
        "focus": [
          "client",
          "api",
          "redis"
        ],
        "note": "SSE 读 Redis 进度频道，与 MySQL 的权威状态读取是两条独立路径。"
      }
    ]
  },
  "participants": [
    {
      "id": "client",
      "type": "external",
      "label": "Client"
    },
    {
      "id": "api",
      "type": "backend",
      "label": "AnalysisService"
    },
    {
      "id": "redis",
      "type": "database",
      "label": "Redis"
    },
    {
      "id": "mysql",
      "type": "database",
      "label": "MySQL"
    },
    {
      "id": "mq",
      "type": "messagebus",
      "label": "RabbitMQ"
    },
    {
      "id": "worker",
      "type": "backend",
      "label": "WorkerService"
    },
    {
      "id": "engine",
      "type": "backend",
      "label": "Agent Engine"
    },
    {
      "id": "llm",
      "type": "external",
      "label": "LLM Provider"
    },
    {
      "id": "mongo",
      "type": "database",
      "label": "MongoDB"
    }
  ],
  "segments": [
    {
      "from": 150,
      "to": 304,
      "label": "同步受理 · ~10-100ms"
    },
    {
      "from": 310,
      "to": 556,
